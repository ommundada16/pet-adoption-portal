# Copy to .env for local overrides:   cp .env.example .env
# Everything has a safe development default, so this file is optional locally.
# On the server, Ansible generates a real .env with random secrets - never commit a real .env.

MYSQL_ROOT_PASSWORD=password
SECRET_KEY=change-this-secret-key
APP_ENV=development

# Which images to run (CI sets IMAGE_TAG to the git commit SHA)
REGISTRY=ghcr.io/ommundada16
IMAGE_TAG=latest

# Monitoring stack
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
